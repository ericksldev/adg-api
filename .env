# =============================================================================
# vrete-api — single source of truth for local dev and Docker Compose
# =============================================================================
# Copy to `.env` in this folder:  cp .env.example .env
# Docker Compose reads `.env` automatically for ${VAR} substitution.
#
# When the API runs inside Docker (`docker compose up`), compose overrides
# DB_HOST=postgres and DB_PORT=5432 on the api service. Values below for
# DB_HOST/DB_PORT apply when you run the API on the host (`npm run dev`).
#
# SaaS catalog DB (DB_NAME): companies, users, sessions. Each company also
# gets a tenant_<uuid> database (DB user must have CREATEDB).
# =============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3010

# --- PostgreSQL credentials (shared by compose + API) ---
DB_USER=adg-user-postgres
DB_PASSWORD=postgres
DB_NAME=adg-db-postgres

# --- API on host → Postgres published by Docker on localhost ---
DB_HOST=localhost
DB_PORT=15432

# --- Docker Compose: host port mappings ---
POSTGRES_HOST_PORT=15432
API_HOST_PORT=3010
NODE_DEBUG_HOST_PORT=9230
UI_PORT=4730
POSTGRES_DOCKER_VOLUME=adg-api_pgdata

# --- Security / HTTP ---
JWT_SECRET=secrete
CORS_ORIGIN=http://localhost:4730

# --- Multi-tenant ---
TENANT_POOL_MAX=32
DB_SYNC_ALTER=false

# --- Password policy (reserved; validators are defined in code today) ---
PASSWORD_VALIDATORS=minLength,uppercase,number,specialChar
PASSWORD_MIN_LENGTH=8

# --- Idempotent SaaS owner seed (runs after DB sync; skips if saas_owner already exists) ---
SEED_SAAS_OWNER_ENABLED=true
SEED_SAAS_COMPANY_NAME=Demo SaaS
SEED_SAAS_OWNER_EMAIL=saas@test.com
SEED_SAAS_OWNER_USERNAME=saas.owner
SEED_SAAS_OWNER_PASSWORD=Demo123!
SEED_SAAS_OWNER_FIRST_NAME=SaaS
SEED_SAAS_OWNER_LAST_NAME=Admin
SEED_SAAS_OWNER_ID_CARD=0000000000
